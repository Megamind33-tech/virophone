# Copy to .env.vps on your LOCAL PC before running scripts/vps-deploy.sh
# Viro Reach is deployed SEPARATELY from your other app (own path, ports, compose project).

# --- SSH (your PC → VPS — same connection you use for the other app) ---
VIRO_VPS_HOST=your.vps.ip.or.hostname
VIRO_VPS_USER=root
VIRO_VPS_PATH=/opt/viro-reach
# Optional: VIRO_SSH_KEY=/path/to/private_key

# --- Public URLs (subdomain recommended; does not touch your other app's domain) ---
CADDY_DOMAIN=viro.yourdomain.com
API_PUBLIC_URL=https://viro.yourdomain.com
AVATAR_UPLOAD_DIR=/opt/viro-reach/uploads/avatars
SIGNALING_PUBLIC_URL=wss://viro.yourdomain.com/api/v1/signaling/ws
TURN_PUBLIC_URL=turn:viro.yourdomain.com:3479

# --- PostgreSQL (internal Docker network only) ---
POSTGRES_USER=viro
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=viro_reach

# --- Secrets (generate: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=change-me-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-min-32-chars
CONTACT_HASH_SALT=change-me-contact-hash-salt-min-32-chars
EPHEMERAL_SIGNING_SECRET=change-me-ephemeral-secret-min-32-chars
TURN_SECRET=change-me-turn-secret-min-32-chars

# --- TURN / network ---
TURN_REALM=viro.yourdomain.com
EXTERNAL_IP=YOUR_VPS_PUBLIC_IPV4
VIRO_TURN_PORT=3479

# --- LiveKit (call media transport) ---
# Own isolated instance for Viro Reach — do not reuse another app's LiveKit
# deployment or keys, even on a shared host. The authoritative key/secret
# values live here; scripts/vps-render-config.sh renders infra/livekit/livekit.vps.yaml
# from the same pair so the API and the server can never drift apart.
# REQUIRED — the API refuses to start in production without all three.
# Generate: LIVEKIT_API_KEY=viro$(openssl rand -hex 10)
#           LIVEKIT_API_SECRET=$(openssl rand -base64 32 | tr -d /+= | head -c 40)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match the /livekit-rtc route in infra/proxy/Caddyfile.host-snippet.
LIVEKIT_URL=wss://viro.yourdomain.com/livekit-rtc
VIRO_LIVEKIT_TCP_BIND=0.0.0.0
VIRO_LIVEKIT_UDP_BIND=0.0.0.0
# TURNS (TURN-over-TLS) relay — see infra/livekit/livekit.vps.yaml. The
# fallback for networks that block direct UDP media outright.
VIRO_LIVEKIT_TURNS_BIND=0.0.0.0
VIRO_LIVEKIT_TURN_RELAY_BIND=0.0.0.0

# --- Caddy on VPS ---
# existing = add snippet to host Caddy (ports 80/443 already used by other app)
# container = run Caddy inside this compose on VIRO_HTTP_PORT / VIRO_HTTPS_PORT
VIRO_CADDY_MODE=existing
VIRO_HTTP_PORT=8080
VIRO_HTTPS_PORT=8443
VIRO_API_BIND=127.0.0.1:13001

# --- API ---
NODE_ENV=production
# console = random OTP logged server-side only (not for physical devices)
# email = send OTP via SMTP (production onboarding — not required for Phase 1A hardware)
# hardware-test = fixed credential for EXPLICIT allowlisted phones only (Phase 1A physical phones)
# console | test | hardware-test | beem | twilio | http
# beem = Beem Africa SMS, the provider for real users in Zambia and the region.
OTP_PROVIDER=hardware-test
# --- Beem Africa (OTP_PROVIDER=beem) ---
# From the Beem dashboard. The sender id must be one Beem has approved for the
# account, or every send is rejected with an "Invalid sender id" style error.
# BEEM_API_KEY=
# BEEM_SECRET_KEY=
# BEEM_SOURCE_ADDR=INFO
# SMS_BODY_TEMPLATE=Your Viro code is {code}
# Phase 1A physical test identities ONLY (exactly these two):
HARDWARE_TEST_PHONES_E164=+260961582985,+260977426940
# Set on VPS only — never commit. 6–32 alphanumeric, not weak patterns (123456, 000000, etc.)
# HARDWARE_TEST_OTP_CODE=
# Email OTP (OTP_PROVIDER=email) — optional later:
# SMTP_HOST=127.0.0.1
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# OTP_EMAIL_FROM=noreply@reach.viro3.online
# OTP_DELIVERY_EMAIL=your-test-inbox@example.com

# --- End-to-end encryption ---
# Phones generate and publish keys regardless; this decides whether they start
# encrypting one-to-one chats. Leave it off until files, voice notes and polls
# can be sealed too: an encrypted chat refuses anything the server would have
# to store in the clear. See docs/encryption-design.md, section 8.
# E2EE_ENABLED=false

# Opens the admin console at /api/v1/admin/console.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=
