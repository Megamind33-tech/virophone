# Copy to .env.vps on your LOCAL PC before running scripts/vps-deploy.sh
# Viro Reach is deployed SEPARATELY from your other app (own path, ports, compose project).

# --- SSH (your PC → VPS — same connection you use for the other app) ---
VIRO_VPS_HOST=your.vps.ip.or.hostname
VIRO_VPS_USER=root
VIRO_VPS_PATH=/opt/viro-reach
# Optional: VIRO_SSH_KEY=/path/to/private_key

# --- Public URLs (subdomain recommended; does not touch your other app's domain) ---
CADDY_DOMAIN=viro.yourdomain.com
API_PUBLIC_URL=https://viro.yourdomain.com
SIGNALING_PUBLIC_URL=wss://viro.yourdomain.com/api/v1/signaling/ws
TURN_PUBLIC_URL=turn:viro.yourdomain.com:3479

# --- PostgreSQL (internal Docker network only) ---
POSTGRES_USER=viro
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=viro_reach

# --- Secrets (generate: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=change-me-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-min-32-chars
CONTACT_HASH_SALT=change-me-contact-hash-salt-min-32-chars
EPHEMERAL_SIGNING_SECRET=change-me-ephemeral-secret-min-32-chars
TURN_SECRET=change-me-turn-secret-min-32-chars

# --- TURN / network ---
TURN_REALM=viro.yourdomain.com
EXTERNAL_IP=YOUR_VPS_PUBLIC_IPV4
VIRO_TURN_PORT=3479

# --- Caddy on VPS ---
# existing = add snippet to host Caddy (ports 80/443 already used by other app)
# container = run Caddy inside this compose on VIRO_HTTP_PORT / VIRO_HTTPS_PORT
VIRO_CADDY_MODE=existing
VIRO_HTTP_PORT=8080
VIRO_HTTPS_PORT=8443
VIRO_API_BIND=127.0.0.1:13001

# --- API ---
NODE_ENV=production
OTP_PROVIDER=console
