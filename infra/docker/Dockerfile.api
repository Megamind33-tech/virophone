FROM node:20-alpine AS builder
WORKDIR /app
COPY packages/shared-types ./packages/shared-types
COPY packages/api-contracts ./packages/api-contracts
COPY apps/api/package*.json ./apps/api/
COPY apps/api/tsconfig*.json ./apps/api/
COPY apps/api/nest-cli.json ./apps/api/
WORKDIR /app/packages/shared-types
RUN npm install && npm run build
WORKDIR /app/packages/api-contracts
RUN npm install && npm run build
WORKDIR /app/apps/api
RUN npm install
COPY apps/api/src ./src
RUN npm run build

FROM node:20-alpine
RUN apk add --no-cache wget
WORKDIR /app
COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/apps/api/node_modules ./node_modules
COPY --from=builder /app/apps/api/package.json ./
COPY apps/api/src/database/migrations ./dist/database/migrations
COPY infra/docker/docker-entrypoint.sh /entrypoint.sh
# Strip CR defensively: a Windows checkout can reintroduce CRLF regardless of
# .gitattributes (an existing clone keeps its line endings), and the resulting
# failure is the misleading "exec /entrypoint.sh: no such file or directory".
RUN sed -i "s/\r$//" /entrypoint.sh && chmod +x /entrypoint.sh
EXPOSE 3001
ENTRYPOINT ["/entrypoint.sh"]
