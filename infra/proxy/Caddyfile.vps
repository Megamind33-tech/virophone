# Viro Reach — container Caddy (non-default ports 8080/8443 unless mapped to 80/443)
# For subdomain on host Caddy, use infra/proxy/Caddyfile.host-snippet instead.

{$CADDY_DOMAIN} {
    encode gzip

    # LiveKit signaling — see the note in Caddyfile.host-snippet. The prefix
    # must be stripped because the Android SDK appends /rtc to LIVEKIT_URL.
    handle /livekit-rtc/* {
        uri strip_prefix /livekit-rtc
        reverse_proxy livekit:7980
    }

    handle /api/v1/signaling/* {
        reverse_proxy api:3001
    }

    handle /api/* {
        reverse_proxy api:3001
    }

    handle /health/* {
        reverse_proxy api:3001
    }

    handle {
        respond "Viro Reach API" 200
    }
}
