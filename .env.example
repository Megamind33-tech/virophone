# =============================================================================
# Viro Reach — Development Environment
# Copy to .env and adjust values. NEVER commit .env to version control.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=viro
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=viro_reach
DATABASE_URL=postgresql://viro:change_me_in_production@localhost:5432/viro_reach

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API Server ---
API_PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3001
AVATAR_UPLOAD_DIR=uploads/avatars

# --- JWT (generate with: openssl rand -base64 64) ---
JWT_ACCESS_SECRET=dev_access_secret_change_in_production
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- OTP ---
# Phone/SMS channel provider: console | test | http | twilio
OTP_PROVIDER=console
OTP_EXPIRES_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Email OTP channel (cheaper than SMS). Transport: console (logs) | smtp | mailtrap
EMAIL_TRANSPORT=console
# Mailtrap (when EMAIL_TRANSPORT=mailtrap). Put the token in secrets, not here.
MAILTRAP_TOKEN=
# sandbox delivers to a Mailtrap inbox (dev); live requires a verified domain
MAILTRAP_MODE=sandbox
MAILTRAP_INBOX_ID=
# EMAIL_FROM below is reused by all email transports (quote it if it has spaces)
# SMTP settings (when EMAIL_TRANSPORT=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Viro Reach <no-reply@viro-reach.local>
EMAIL_SUBJECT=Your Viro Reach code
# HTTP SMS gateway (when OTP_PROVIDER=http)
SMS_API_URL=
SMS_API_KEY=
SMS_FROM=ViroReach
# Twilio (when OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Rate Limiting ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
CONTACT_DISCOVERY_MAX_BATCH=200
CONTACT_DISCOVERY_RATE_LIMIT=10

# --- Caddy ---
CADDY_DOMAIN=localhost

# --- FlexiSIP (signaling) ---
FLEXISIP_DOMAIN=localhost
FLEXISIP_SIP_PORT=5060

# --- coturn (NAT traversal) ---
TURN_REALM=viro-reach.local
# Must match coturn's static-auth-secret (see infra/coturn/turnserver.conf)
TURN_SECRET=dev_turn_secret
TURN_PORT=3478
# Public/LAN-reachable TURN host advertised to clients. Leave blank to advertise
# public STUN only (fine on the same network / permissive NAT). Set to the
# server's public address (or the dev machine's LAN IP) to enable relaying.
TURN_HOST=
# Optional TURN-over-TLS port (e.g. 443) for the most restrictive networks.
TURN_TLS_PORT=
# TURN transports to advertise (comma separated: udp,tcp).
TURN_TRANSPORTS=udp,tcp
# Public STUN servers always advertised as the cheap first option.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# --- Contact matching ---
CONTACT_HASH_SALT=change_me_contact_hash_salt

# --- Ephemeral discovery signing ---
EPHEMERAL_SIGNING_SECRET=change_me_ephemeral_signing_secret
EPHEMERAL_TTL_SECONDS=900

# --- TURN credential TTL ---
TURN_CREDENTIAL_TTL_SECONDS=3600

# --- Admin bootstrap (optional, dev only) ---
ADMIN_EMAIL=admin@viro-reach.local
