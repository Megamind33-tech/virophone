# =============================================================================
# Viro Reach — Development Environment
# Copy to .env and adjust values. NEVER commit .env to version control.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=viro
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=viro_reach
DATABASE_URL=postgresql://viro:change_me_in_production@localhost:5432/viro_reach

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API Server ---
API_PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001

# --- JWT (generate with: openssl rand -base64 64) ---
JWT_ACCESS_SECRET=dev_access_secret_change_in_production
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- OTP (development provider) ---
OTP_PROVIDER=console
OTP_EXPIRES_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Rate Limiting ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
CONTACT_DISCOVERY_MAX_BATCH=200
CONTACT_DISCOVERY_RATE_LIMIT=10

# --- Caddy ---
CADDY_DOMAIN=localhost

# --- FlexiSIP (signaling) ---
FLEXISIP_DOMAIN=localhost
FLEXISIP_SIP_PORT=5060

# --- coturn (NAT traversal) ---
TURN_REALM=viro-reach.local
TURN_SECRET=change_me_turn_secret
TURN_PORT=3478

# --- Contact matching ---
CONTACT_HASH_SALT=change_me_contact_hash_salt

# --- Admin bootstrap (optional, dev only) ---
ADMIN_EMAIL=admin@viro-reach.local
