<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The mark is drawn on white in the brand artwork, so the adaptive
         icon's background layer matches it rather than showing a dark edge
         behind the logo under the launcher's mask. -->
    <color name="ic_launcher_background">#FFFFFF</color>
    <color name="ic_launcher_foreground">#4FC3F7</color>
    <!-- Tint behind the notification icon in the shade; the mark's blue. -->
    <color name="notification_accent">#1565F5</color>
    <!-- Viro navy: the window, the Android 12 splash and the opening screen,
         so opening is one surface from the tap onwards. Matches
         ViroColors.NavyBackground. -->
    <color name="viro_opening">#00122C</color>
</resources>
